<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <SwitchPreference
        android:key="boot_start"
        android:title="@string/pref_boot_start_title"
        android:summary="@string/pref_boot_start_summary" />

    <SwitchPreference
        android:key="soft_reboot"
        android:title="@string/pref_soft_reboot_title"
        android:summary="@string/pref_soft_reboot_summary"
        android:defaultValue="false" />

    <SwitchPreference
        android:key="disable_modules"
        android:title="@string/pref_disable_modules_title"
        android:summary="@string/pref_disable_modules_summary"
        android:defaultValue="false" />

    <SwitchPreference
        android:key="auto_save_log"
        android:title="@string/pref_auto_save_title"
        android:summary="@string/pref_auto_save_summary"
        android:defaultValue="false" />

    <Preference
        android:key="version"
        android:title="@string/pref_version_title"
        android:selectable="false" />

    <Preference
        android:key="about"
        android:title="@string/pref_about_title"
        android:summary="@string/pref_about_summary">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://github.com/diabl0w/DFRoot" />
    </Preference>

</PreferenceScreen>
