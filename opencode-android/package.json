{
  "name": "opencode-android",
  "version": "2.2.5",
  "private": true,
  "type": "module",
  "description": "Complete working Android port of anomalyco/opencode (Background Daemon Service + Local Workspaces + Full Agent Tools + 1:1 OpenCode v2 UI)",
  "scripts": {
    "dev": "node server/dev-daemon.mjs",
    "start": "node server/dev-daemon.mjs",
    "build:web": "tsc --noEmit && vite build",
    "build:apk": "npm run build:web && node scripts/build-apk.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
