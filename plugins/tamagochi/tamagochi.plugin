        self._result_dialog("Как играть", lines)

    # ========================================================================
    # МИНИ-ИГРЫ
    # ========================================================================
    # Шесть игр в диалогах: напёрстки, реакция, память, викторина, кости
    # и мышеловка на сетке кнопок. Общее: перезарядка, расход бодрости,
    # счётчики игр/побед, монеты и опыт навыков.

    def _game_ready(self):
        """Проверяет, можно ли играть. Возвращает state или None."""
        state = self._pet or self._state()
        if state is None:
            self._pick_species()
            return None
        if int(state.get("stage", 0)) == 0:
            self._show_pet_dialog(message="Яйцо пока играет только в «полежу-погреюсь»")
            return None
        now = time.time()
        last = float((state.get("last") or {}).get("game", 0) or 0)
        if now - last < GAME_COOLDOWN:
            left = int((GAME_COOLDOWN - (now - last)) / 60) + 1
            self._show_pet_dialog(message="Питомец запыхался: следующий раунд через ~%d мин" % left)
            return None
        needs = state.get("needs", {})
        if needs.get("energy", 100) < GAME_ENERGY + 5:
            self._show_pet_dialog(message="Слишком устал — сначала отдых или перекус")
            return None
        state.setdefault("last", {})["game"] = now
        needs["energy"] = _clamp(needs.get("energy", 100) - GAME_ENERGY)
        if state.get("sleep"):
            state["sleep"] = False
        return state

    def _game_finish(self, state, won, lines, skill="agility", xp=8, coins=None):
        """Общий финал партии: награды, счётчики, сохранение, диалог."""
        counter_add(state, "games_played")
        mood_shift = 8 if won else 3
        needs = state.setdefault("needs", {})
        needs["mood"] = _clamp(needs.get("mood", 100) + mood_shift)
        add_skill_xp(state, skill, xp if won else xp // 2)
        if won:
            counter_add(state, "games_won")
            if coins is None:
                coins = random.randint(GAME_REWARD_MIN, GAME_REWARD_MAX)
            earn(state, coins)
            lines.append("🏅 Победа! +%s" % _coins_text(coins))
            lines.append(random.choice(GAME_WIN_LINES))
        else:
            lines.append("В другой раз повезёт больше")
            lines.append(random.choice(GAME_LOSE_LINES))
        self._save_state(state)
        check_quests(state)
        self._save_state(state)
        self._result_dialog("Игра окончена", lines)

    def _pick_game(self):
        state = self._pet or self._state()
        if state is None:
            return
        games = (
            ("🥤 Напёрстки", self._game_cups),
            ("⚡ Реакция", self._game_reaction_start),
            ("🧠 Память", self._game_memory),
            ("❓ Викторина", self._game_quiz),
            ("🎲 Кости", self._game_dice),
            ("🐭 Мышеловка", self._game_hunt),
        )

        def pick(builder, index):
            try:
                builder.dismiss()
            except Exception:
                pass
            if 0 <= index < len(games):
                games[index][1]()

        try:
            dialog = AlertDialogBuilder(self._activity())
            dialog.set_title("Мини-игры")
            dialog.set_message("Перезарядка %s, бодрость −%d. Питомец очень любит играть" % (
                _minutes_text(GAME_COOLDOWN // 60), GAME_ENERGY))
            dialog.set_items([name for name, _fn in games], pick)
            dialog.set_negative_button("Закрыть", lambda builder, which: builder.dismiss())
            dialog.show()
        except Exception:
            self.logger.exception("games dialog failed")

    # ---- напёрстки ----

    def _game_cups(self):
        state = self._game_ready()
        if state is None:
            return
        secret = random.randint(0, 2)
        items = ["🥤 стакан", "🥤 стакан", "🥤 стакан"]

        def pick(builder, index):
            try:
                builder.dismiss()
            except Exception:
                pass
            won = index == secret
            if won:
                counter_add(state, "cups_wins")
            lines = ["Под стаканом №%d пряталось лакомство 🍪" % (secret + 1)]
            if won:
                lines.append("Питомец в восторге: угадал с первого раза!")
            else:
                lines.append("Мимо. Питомец сделал вид, что так и задумано")
            self._game_finish(state, won, lines, skill="wits", xp=8)

        try:
            dialog = AlertDialogBuilder(self._activity())
            dialog.set_title("Напёрстки")
            dialog.set_message("Под одним из трёх стаканов лакомство. Чутьё или удача?")
            dialog.set_items(items, pick)
            dialog.set_negative_button("Отмена", lambda builder, which: builder.dismiss())
            dialog.show()
        except Exception:
            self.logger.exception("cups failed")

    # ---- реакция ----

    def _game_reaction_start(self):
        state = self._game_ready()
        if state is None:
            return
        delay_ms = random.randint(1200, 3500)

        def go():
            self._game_reaction_go(state)

        try:
            dialog = AlertDialogBuilder(self._activity())
            dialog.set_title("Реакция")
            dialog.set_message("Закрой окно — и как только появится «ЖМИ!», жми кнопку. Промедление = поражение")
            dialog.set_positive_button("Начать", lambda builder, which: run_on_ui_thread(go, delay_ms))
            dialog.set_negative_button("Отмена", lambda builder, which: builder.dismiss())
            dialog.show()
        except Exception:
            self.logger.exception("reaction start failed")

    def _game_reaction_go(self, state):
        self._reaction_started = time.time()

        def hit(builder, which):
            delta_ms = int((time.time() - getattr(self, "_reaction_started", time.time())) * 1000)
            try:
                builder.dismiss()
            except Exception:
                pass
            won = delta_ms <= REACTION_GOOD_MS
            if delta_ms <= REACTION_PERFECT_MS:
                counter_add(state, "reaction_flash")
                lines = ["⚡ %d мс — реакция космонавта!" % delta_ms]
                coins = GAME_REWARD_MAX + 5
            elif won:
                lines = ["👏 %d мс — очень быстро!" % delta_ms]
                coins = None
            else:
                lines = ["🐢 %d мс — питомец успел сбегать за печеньем и вернуться" % delta_ms]
                coins = 0
            self._game_finish(state, won, lines, skill="agility",
                              xp=10 if delta_ms <= REACTION_PERFECT_MS else 6, coins=coins)

        try:
            dialog = AlertDialogBuilder(self._activity())
            dialog.set_title("ЖМИ!")
            dialog.set_message("⬇️⬇️⬇️")
            dialog.set_positive_button("ЖМУ!", hit)
            dialog.set_negative_button("Ой, не готов", lambda builder, which: builder.dismiss())
            dialog.show()
        except Exception:
            self.logger.exception("reaction go failed")

    # ---- память ----

    def _game_memory(self):
        state = self._game_ready()
        if state is None:
            return
        emojis = ("🐱", "🐶", "🐰", "🦊", "🐼", "🐸", "🦉", "🐻")
        sequence = random.sample(emojis, 4)
        ask_index = random.randint(1, 4)

        def memorized(builder, which):
            try:
                builder.dismiss()
            except Exception:
                pass
            options = random.sample(emojis, 4)
            if sequence[ask_index - 1] not in options:
                options[random.randint(0, 3)] = sequence[ask_index - 1]

            def pick(builder2, index):
                try:
                    builder2.dismiss()
                except Exception:
                    pass
                won = options[index] == sequence[ask_index - 1]
                if won:
                    counter_add(state, "memory_wins")
                lines = ["Последовательность была: " + " ".join(sequence),
                         "Спрашивали про позицию №%d" % ask_index]
                self._game_finish(state, won, lines, skill="wits", xp=9)

            try:
                dialog = AlertDialogBuilder(self._activity())
                dialog.set_title("Каким был №%d?" % ask_index)
                dialog.set_items(options, pick)
                dialog.set_negative_button("Сдаюсь", lambda b, w: b.dismiss())
                dialog.show()
            except Exception:
                self.logger.exception("memory ask failed")

        try:
            dialog = AlertDialogBuilder(self._activity())
            dialog.set_title("Память")
            dialog.set_message("Запоминай:\n\n" + " ".join(sequence) + "\n\nПотом спросим про одного из них")
            dialog.set_positive_button("Запомнил", memorized)
            dialog.set_negative_button("Отмена", lambda builder, which: builder.dismiss())
            dialog.show()
        except Exception:
            self.logger.exception("memory failed")

    # ---- викторина ----

    def _game_quiz(self, rounds_done=0, correct=0, state=None):
        if state is None:
            state = self._game_ready()
            if state is None:
                return
        if rounds_done >= QUIZ_ROUNDS:
            won = correct >= (QUIZ_ROUNDS + 1) // 2
            lines = ["Правильных ответов: %d из %d" % (correct, QUIZ_ROUNDS)]
            if won:
                lines.append("Питомец смотрит с уважением 🧠")
            else:
                lines.append("Питомец подсказывал как умел")
            self._game_finish(state, won, lines, skill="wits", xp=6 * correct,
                              coins=(GAME_REWARD_MIN + 3 * correct) if won else 0)
            return

        question, options, right = random.choice(QUIZ)

        def pick(builder, index):
            try:
                builder.dismiss()
            except Exception:
                pass
            hit = index == right
            if hit:
                counter_add(state, "quiz_correct")
            line = "Верно!" if hit else "Правильный ответ: %s" % options[right]
            BulletinHelper.show_info(line) if hit else BulletinHelper.show_error(line)
            self._game_quiz(rounds_done + 1, correct + (1 if hit else 0), state)

        try:
            dialog = AlertDialogBuilder(self._activity())
            dialog.set_title("Викторина %d/%d" % (rounds_done + 1, QUIZ_ROUNDS))
            dialog.set_message(question)
            dialog.set_items(list(options), pick)
            dialog.set_negative_button("Хватит", lambda builder, which: builder.dismiss())
            dialog.show()
        except Exception:
            self.logger.exception("quiz failed")

    # ---- кости ----

    def _game_dice(self):
        state = self._game_ready()
        if state is None:
            return
        if not spend(state, DICE_BET):
            self._show_pet_dialog(message="Нужно %s на ставку" % _coins_text(DICE_BET))
            return
        mine = (random.randint(1, 6), random.randint(1, 6))
        pet = (random.randint(1, 6), random.randint(1, 6))
        my_sum, pet_sum = sum(mine), sum(pet)
        lines = [
            "Ты: %s = %d" % (" + ".join(str(value) for value in mine), my_sum),
            "Питомец: %s = %d" % (" + ".join(str(value) for value in pet), pet_sum),
        ]
        if pet_sum > my_sum:
            won = True
            lines.append("Питомец победил и честно делится выигрышем")
            self._game_finish(state, won, lines, skill="charm", xp=7, coins=DICE_BET * 2)
        elif pet_sum < my_sum:
            won = False
            lines.append("Ты выиграл — ставка остаётся тебе, питомец не в обиде")
            counter_add(state, "dice_wins")
            self._game_finish(state, won, lines, skill="charm", xp=7, coins=0)
        else:
            doubles = mine[0] == mine[1]
            lines.append("Ничья! %s" % ("И дубли — питомец в восторге, монеты возвращаются" if doubles else "Монеты возвращаются"))
            earn(state, DICE_BET)
            counter_add(state, "games_played")
            needs = state.setdefault("needs", {})
            needs["mood"] = _clamp(needs.get("mood", 100) + 5)
            self._save_state(state)
            self._result_dialog("Кости", lines)

    # ---- мышеловка ----

    def _game_hunt(self):
        state = self._game_ready()
        if state is None:
            return
        self._hunt = {"state": state, "mouse": random.randint(0, 8), "taps": 0,
                      "max_taps": HUNT_TAPS}

        try:
            from android.view import Gravity
            from android.widget import Button, GridLayout, LinearLayout

            activity = self._activity()
            if activity is None:
                return
            from android_utils import OnClickListener

            grid = GridLayout(activity)
            grid.setColumnCount(3)
            grid.setPadding(AndroidUtilities.dp(8), AndroidUtilities.dp(4), AndroidUtilities.dp(8), AndroidUtilities.dp(4))
            buttons = []
            for index in range(9):
                button = Button(activity)
                button.setText("🕳")
                button.setTextSize(22)
                button.setOnClickListener(OnClickListener(lambda view, index=index: self._hunt_tap(index, buttons)))
                buttons.append(button)
                grid.addView(button)
            note = self._text_view("Мышка прячется в одной из норок. Найди её за %d тапа —\n"
                                   "после каждого она может перебежать" % HUNT_TAPS)
            holder = self._vertical(grid, note)
            if holder is None:
                self._game_cups()
                return

            dialog = AlertDialogBuilder(self._activity())
            dialog.set_title("Мышеловка")
            dialog.set_view(holder, -2)
            dialog.set_negative_button("Сдаюсь", lambda builder, which: builder.dismiss())
            dialog.show()
            self._hunt["dialog_open"] = True
        except Exception:
            self.logger.exception("hunt failed")
            self._game_cups()

    def _hunt_tap(self, index, buttons):
        hunt = getattr(self, "_hunt", None)
        if not hunt or not hunt.get("dialog_open"):
            return
        state = hunt["state"]
        hunt["taps"] += 1
        if index == hunt["mouse"]:
            hunt["dialog_open"] = False
            try:
                buttons[index].setText("🐭")
            except Exception:
                pass
            counter_add(state, "mice_caught")
            lines = ["Мышка найдена с %d-й попытки!" % hunt["taps"]]
            self._game_finish(state, True, lines, skill="agility",
                              xp=12 - hunt["taps"], coins=max(6, GAME_REWARD_MAX - hunt["taps"] * 2))
            return
        try:
            buttons[index].setText("✖")
        except Exception:
            pass
        if random.random() < 0.3:
            hunt["mouse"] = random.choice([cell for cell in range(9) if cell != index])
            for button in buttons:
                try:
                    button.setText("🕳")
                except Exception:
                    pass
        if hunt["taps"] >= hunt["max_taps"]:
            hunt["dialog_open"] = False
            lines = ["Мышка перехитрила всех — в другой раз"]
            self._game_finish(state, False, lines, skill="agility", xp=4)

    # ========================================================================
    # ВЫБОР ПИТОМЦА
    # ========================================================================

    def _pick_species(self, view=None):
        self._activate(view)
        try:
            dialog = AlertDialogBuilder(self._activity())
            dialog.set_title("Кто вылупится?")
            dialog.set_message("Восемь… нет, десять видов на выбор. У каждого — характер, вкусы и фирменный номер")
            dialog.set_items(
                ["%s  %s — %s" % (SPECIES[key]["emoji"][3], SPECIES[key]["label"], SPECIES[key]["trait"])
                 for key in SPECIES_ORDER],
                self._pick_species_entry,
            )
            dialog.set_negative_button("Отмена", lambda builder, which: builder.dismiss())
            dialog.show()
        except BaseException:
            self.logger.exception("species dialog failed")
            self._show_error_dialog("Не открылся выбор питомца")

    def _pick_species_entry(self, builder, index):
        try:
            builder.dismiss()
        except Exception:
            pass
        if not 0 <= index < len(SPECIES_ORDER):
            return
        species_id = SPECIES_ORDER[index]
        species = SPECIES[species_id]
        unique = UNIQUE_ACTIONS.get(species.get("unique")) or {}

        def adopt(builder2, which):
            try:
                builder2.dismiss()
            except Exception:
                pass
            self._adopt(species_id)

        try:
            confirm = AlertDialogBuilder(self._activity())
            confirm.set_title("Завести %s?" % species["label"].lower())
            confirm.set_message(
                "%s\n\n%s\nХарактер: %s. Фирменный номер: %s\n\nТекущий питомец, если он есть, "
                "начнёт жизнь заново — с яйца." % (
                    species["about"], species["lore"], species["trait"], unique.get("label", "—")))
            confirm.set_positive_button("Завести", adopt)
            confirm.set_negative_button("Отмена", lambda which_builder, which: which_builder.dismiss())
            confirm.show()
        except Exception:
            self.logger.exception("confirm dialog failed")

    def _adopt(self, species_id):
        try:
            state = new_state(species_id)
            self._save_state(state)
            self._pet = state
            BulletinHelper.show_success("Яйцо завёрнуто в одеяло 🥚")
            journal_add(state, "adopt", "Заведено яйцо: %s" % SPECIES[species_id]["label"])
            self._save_state(state)
            self._sync_if_needed(state, force=True)
            self._show_pet_dialog()
        except BaseException:
            self.logger.exception("adopt failed")
            self._show_error_dialog("Не получилось завести питомца")

    def _on_menu(self, context):
        self._activate(None)
        self._show_pet_dialog()


# ============================================================================
# ФИНАЛЬНЫЙ КЛАСС ПЛАГИНА
# ============================================================================
# Единственный наследник BasePlugin в модуле: его и находит загрузчик.
# Собирает движок (TamagochiCore) и диалоги (TamagochiDialogs), добавляет
# экран настроек и точку входа меню.

class TamagochiPlugin(TamagochiDialogs, BasePlugin):
    """Единственный наследник BasePlugin: движок + диалоги + настройки."""

    def create_settings(self):
        rows = []
        try:
            state = self._state()
        except BaseException:
            self.logger.exception("settings build failed")
            state = None

        try:
            card = self._pet_card(state)
            if card is not None:
                    rows.append(Custom(view=card))
        except BaseException:
            self.logger.exception("pet card failed")

        if state is None:
            rows.extend([
                Header(text="Тамагочи"),
                Text(
                    text="🥚 Завести питомца",
                    subtext="Десять видов со своими характерами, вкусами и фокусами",
                    icon="msg_info",
                    on_click=self._pick_species,
                ),
                Text(
                    text="📜 Как играть",
                    subtext="Короткая справка о питомце, монетах и прогулках",
                    icon="msg_info",
                    on_click=lambda view: self._activate(view) or self._show_guide(),
                ),
            ])
        else:
            stage = int(state.get("stage", 0))
            rows.append(Header(text="Уход"))
            if stage == 0:
                rows.append(Text(
                    text=CARE_TITLES["warm"],
                    subtext=CARE_NOTES["warm"],
                    icon="msg_info",
                    on_click=self._warm_row,
                ))
            else:
                rows.extend([
                    Text(text=CARE_TITLES["pet"], subtext=CARE_NOTES["pet"], icon="msg_info", on_click=self._pet_row),
                    Text(text=CARE_TITLES["feed"], subtext=CARE_NOTES["feed"], icon="msg_info", on_click=self._feed_row),
                    Text(text=CARE_TITLES["play"], subtext=CARE_NOTES["play"], icon="msg_info", on_click=self._play_row),
                    Text(text=CARE_TITLES["wash"], subtext=CARE_NOTES["wash"], icon="msg_info", on_click=self._wash_row),
                    Text(
                        text="⏰ Разбудить" if state.get("sleep") else "😴 Уложить спать",
                        subtext="Бодрость восстанавливается сама, пока питомец спит",
                        icon="msg_info",
                        on_click=self._sleep_row,
                    ),
                    Text(
                        text=CARE_TITLES["train"],
                        subtext=CARE_NOTES["train"],
                        icon="msg_info",
                        on_click=self._train_row,
                    ),
                ])
                species = species_of(state)
                unique = UNIQUE_ACTIONS.get(species.get("unique"))
                if unique:
                    rows.append(Text(
                        text=unique["label"],
                        subtext=unique["note"],
                        icon="msg_info",
                        on_click=self._unique_row,
                    ))
                rows.append(Text(
                        text=CARE_TITLES["walk"] if not state.get("walk") else "🌳 Как прогулка?",
                        subtext=CARE_NOTES["walk"],
                        icon="msg_info",
                        on_click=self._walk_row,
                    ))
                rows.append(Text(
                        text="💼 На работу" if not state.get("job") else "💼 Забрать со смены",
                        subtext="Зарплата по навыку: от курьера до астронавта",
                        icon="msg_info",
                        on_click=self._job_row,
                    ))
                rows.append(Text(
                        text="🎮 Мини-игры",
                        subtext="Напёрстки, реакция, память, викторина, кости, мышеловка",
                        icon="msg_info",
                        on_click=self._games_row,
                    ))
            rows.append(Header(text="Хозяйство"))
            rows.extend([
                Text(text="🛒 Магазин", subtext="Еда, игрушки, аксессуары, аптека",
                     icon="msg_info", on_click=self._shop_row),
                Text(text="🎒 Кладовая и гардероб", subtext="Съестное, игрушки, лекарства, шляпы",
                     icon="msg_info", on_click=self._inventory_row),
                Text(text="👨‍🍳 Кухня", subtext="Блюда сытнее ингредиентов",
                     icon="msg_info", on_click=self._recipe_row),
            ])
            rows.append(Header(text="Питомец"))
            rows.extend([
                Input(
                    key="pet_name",
                    text="Имя питомца",
                    default="",
                    subtext="Пусто — зовём по виду",
                    icon="msg_info",
                ),
                Text(text="🥚 Завести нового", subtext="Текущий уйдёт: всё начнётся с яйца",
                     icon="msg_info", on_click=self._pick_species),
                Switch(
                    key="show_status",
                    text="Показывать у ника",
                    default=True,
                    subtext="Эмодзи-статус: видят все, даже без плагина. Нужен премиум",
                    icon="msg_info",
                ),
                Text(text="🔄 Обновить статус", subtext="Поставить эмодзи питомца у ника вручную",
                     icon="msg_info", on_click=self._force_sync),
                Text(text="🏆 Ещё", subtext="Достижения, журнал, профиль, альбом, справка",
                     icon="msg_info", on_click=self._more_row),
            ])
        rows.extend([
            Divider(),
            Text(
                text="О плагине",
                subtext="Версия %s · %s" % (__version__, __author__),
                icon="msg_info",
                create_sub_fragment=self._about_page,
            ),
        ])
        return rows

    def _about_page(self):
        return [
            Header(text="Тамагочи"),
            Text(
                text="Что это",
                subtext="Питомец, который живёт в мессенджере: растёт по настоящему времени, "
                        "ест, гуляет, работает и играет. Всё состояние — локально, в телефоне.",
                icon="msg_info",
            ),
            Text(
                text="Виды",
                subtext="Десять персонажей, у каждого свои скорости потребностей, любимая еда, "
                        "фирменный номер и реплики. Анимации нарисованы генератором в репозитории.",
                icon="msg_info",
            ),
            Text(
                text="Монеты",
                subtext="За заботу, прогулки, работу, игры и ежедневные серии. Тратятся в магазинах "
                        "еды, игрушек, аксессуаров и аптеки.",
                icon="msg_info",
            ),
            Text(
                text="У ника",
                subtext="Эмодзи-статус с текущей формой питомца: видят все рядом с именем. "
                        "Ставит его Telegram — нужен премиум, плагин лишь обновляет.",
                icon="msg_info",
            ),
            Text(
                text="Приватность",
                subtext="Ничего не отправляется наружу: к серверу идут только запросы эмодзи-статуса. "
                        "Питомец никуда не уйдёт без тебя.",
                icon="msg_info",
            ),
            Text(
                text=__author__,
                subtext="Автор, нажми чтобы скопировать",
                icon="msg_info",
                on_click=lambda _view: self._copy_author(),
            ),
        ]

    def _copy_author(self):
        try:
            from android_utils import copy_to_clipboard

            copy_to_clipboard(__author__)
            BulletinHelper.show_success("Автор скопирован")
        except Exception:
            self.logger.exception("copy failed")

    # ---- обёртки строк настроек: каждая активирует контекст окна ----

    def _warm_row(self, view=None):
        self._activate(view)
        self._care_and_show("warm")

    def _pet_row(self, view=None):
        self._activate(view)
        self._care_and_show("pet")

    def _feed_row(self, view=None):
        self._activate(view)
        self._pick_food()

    def _play_row(self, view=None):
        self._activate(view)
        self._care_and_show("play")

    def _wash_row(self, view=None):
        self._activate(view)
        self._care_and_show("wash")

    def _sleep_row(self, view=None):
        self._activate(view)
        self._care_and_show("sleep")

    def _train_row(self, view=None):
        self._activate(view)
        self._care_and_show("train")

    def _unique_row(self, view=None):
        self._activate(view)
        self._unique_and_show()

    def _walk_row(self, view=None):
        self._activate(view)
        self._pick_location()

    def _job_row(self, view=None):
        self._activate(view)
        if (self._pet or self._state() or {}).get("job"):
            self._finish_job_and_show()
        else:
            self._pick_job()

    def _games_row(self, view=None):
        self._activate(view)
        self._pick_game()

    def _shop_row(self, view=None):
        self._activate(view)
        self._pick_shop()

    def _inventory_row(self, view=None):
        self._activate(view)
        self._show_inventory()

    def _recipe_row(self, view=None):
        self._activate(view)
        self._pick_recipe()

    def _more_row(self, view=None):
        self._activate(view)
        self._show_more()

    def _force_sync(self, view=None):
        self._activate(view)
        try:
            state = self._pet or self._state()
            if state is None:
                self._show_pet_dialog(message="Сначала заведи питомца 🥚")
                return
            if not self._show_status_setting():
                self._show_pet_dialog(message="Показ у ника выключен в настройках")
                return
            self._sync_busy = False
            self._sync_status()
            BulletinHelper.show_info("Обновляю эмодзи у ника…")
        except BaseException:
            self.logger.exception("force sync failed")
            self._show_error_dialog("Не получилось обновить статус")


# ============================================================================
# РАСШИРЕННЫЙ КАТАЛОГ (DLC-пак №1: гастрономия)
# ============================================================================
# Отдельные блоки «расширений» докупаются в базовые таблицы после основных
# определений. Так базовый слой остаётся компактным и читаемым, а каталог
# растёт пачками — как настоящие игровые DLC. Все ключи новые: конфликтов
# с базой нет, движок подхватывает всё сам, потому что магазины, кладовая
# и кухня читают таблицы целиком в момент открытия.

