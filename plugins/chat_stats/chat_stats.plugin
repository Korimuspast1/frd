PAGE_SIZE = 100
DEPTHS = (300, 1000, 2000, 5000, 10000)
DEPTH_LABELS = ("300", "1 000", "2 000", "5 000", "10 000")
DEFAULT_DEPTH = 2
TOP_AUTHORS = 8
TOP_WORDS = 14
TOP_PAUSES = 3
MIN_PAUSE = 3600
BLOCKS = "▁▂▃▄▅▆▇█"
DAY_NAMES = ("Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс")
WORD_RE = re.compile(r"[0-9A-Za-zА-Яа-яЁё_]{3,}")

